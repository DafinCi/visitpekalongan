# ==============================================================================
# VISITPEKALONGAN ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE AND SEO CONFIGURATION (Phase 1 - MVP)
# ------------------------------------------------------------------------------
# Public site URL used for canonical links and Open Graph previews for WhatsApp and Twitter.
# Local development: http://localhost:3000
# Production: https://visitpekalongan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CARTO Basemaps API key used to remove the watermark from map tiles.
# Get a free key at: https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Phase 2 - Migration Target)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Supabase / Neon / Railway) for migration
# from LocalSpotRepository to Drizzle ORM.
# DATABASE_URL=postgresql://user:password@host:5432/visitpekalongan?sslmode=require

# ------------------------------------------------------------------------------
# 3. MEDIA STORAGE AND CDN (Phase 2 - Optional)
# ------------------------------------------------------------------------------
# Cloudflare R2 / Supabase Storage credentials for user photo gallery uploads.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# NEXT_PUBLIC_MEDIA_CDN_URL=https://media.visitpekalongan.com

