# ==============================================================================
# VISITPEKALONGAN ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI SITUS & SEO (Fase 1 - MVP)
# ------------------------------------------------------------------------------
# URL publik utama situs untuk canonical link dan pratinjau gambar Open Graph WhatsApp/Twitter.
# Saat development lokal: http://localhost:3000
# Saat produksi: https://visitpekalongan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE POSTGRESQL (Fase 2 - Target Migrasi)
# ------------------------------------------------------------------------------
# String koneksi database PostgreSQL (Supabase / Neon / Railway) saat bermigrasi
# dari LocalSpotRepository ke Drizzle ORM.
# DATABASE_URL=postgresql://user:password@host:5432/visitpekalongan?sslmode=require

# ------------------------------------------------------------------------------
# 3. PENYIMPANAN MEDIA & CDN (Fase 2 - Opsional)
# ------------------------------------------------------------------------------
# Kredensial Cloudflare R2 / Supabase Storage untuk upload galeri foto pengguna
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# NEXT_PUBLIC_MEDIA_CDN_URL=https://media.visitpekalongan.com

